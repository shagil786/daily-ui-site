LLM_PROVIDER=openai
LLM_API_KEY=
# Any OpenAI-compatible host (NVIDIA NIM, Together, a local gateway, ...).
# Leave unset for OpenAI. The version segment belongs here; /chat/completions is appended.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id. Defaults to OpenAI's gpt-5.4; set it for other hosts.
# LLM_MODEL=z-ai/glm-5.3-flash
# Output token cap. Omitted by default (OpenAI's newer reasoning models reject it).
# Reasoning models need a LOT: measured on z-ai/glm-5.3-flash, thinking alone
# consumed ~2600-3400 tokens before a single byte of document.
# LLM_MAX_TOKENS=16384
# Ceiling on one provider call in ms (default 600000). Raise it only for very
# slow hosts; lower it to fail fast instead of holding a request open.
# LLM_TIMEOUT_MS=600000
GENERATE_SECRET=change-me
DATABASE_PATH=./data/days.db
# Visitor previews allowed per UTC day for the whole process (default 50); a restart resets it.
PREVIEW_DAILY_CAP=50